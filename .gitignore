# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Throwaway exploration specs. Writing one to poke at live IndexedDB/outbox
# state is a normal part of authoring an E2E spec, but it must never reach the
# repo — anything matching *.spec.js under e2e/ is otherwise collected by
# `npm run test:e2e`, including in CI. playwright.config.js ignores the same
# pattern so a local run skips them too.
e2e/**/scratch.spec.js
e2e/**/*.scratch.spec.js

# Playwright run output (traces/screenshots may embed fixture data)
test-results/
playwright-report/
blob-report/
.playwright/

# Google Drive sync temp artifacts
.tmp.driveupload/

# Local DB backups (may contain user data / PII — never commit)
db_backups/

# Generated code-graph artifacts (rebuild with Graphify; never authoritative)
graphify-out/

# Native build output (once Capacitor shells are added)
ios/App/DerivedData/
android/.gradle/
android/app/build/

.vercel
.env*
